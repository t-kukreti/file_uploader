<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=folder.name%>
    </title>
</head>

<body>
    <h2>
        <%= folder.name %>
    </h2>

    <% if(folder.files.length===0 ){ %>
        <p>No files are present</p>
        <% }else{ %>

            <ul>
                <% folder.files.forEach((file)=>{ %>
                    <%- include('partials/fileItem', {file}) %>
                    <% }); %>
            </ul>
            <% } %>

                <a href="/uploads/uploadFile?folderId=<%=folder.id%>">upload file to this folder</a>



</body>

</html>