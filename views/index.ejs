<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HomePage</title>
</head>
<script src="/js/showRenameBtn.js"></script>

<body>

    <%- include("partials/errors", { errors }) %>

    <% if(currentUser){ %>
        <p>Logged in as <%=currentUser.email %>
        </p>
        <a href="/auth/logout">logout</a>
        <a href="/uploads/uploadFile">upload a file</a>
        <a href="/folders/new">Create a folder</a>

        <h3>Your Folders </h3>
        <% if(folders.length==0){ %>
            <p>No Folders yet</p>
            <% }else{ %>
                <ul>
                    <% folders.forEach((folder)=>{ %>
                        <li>
                            <a href="/folders/<%=folder.id%>">
                                <%= folder.name %>
                            </a>

                            <form action="/folders/<%=folder.id%>/delete" method="post" style="display: inline;">
                                <button type="submit" onclick="return confirm('This will delete the folder and all files inside it, do you want to continue?')">Delete</button>
                            </form>

                            <button type="button" onclick="
                            this.nextElementSibling.style.display='inline';
                            this.style.display = 'none';
                            ">Rename</button>
                            <form action="/folders/<%=folder.id%>/rename" method="post" style="display: none;">
                                <div>
                                    <label for="newFolderName-<%=folder.id%>">folderName:</label>
                                    <input type="text" name="newFolderName" id="newFolderName-<%=folder.id%>" value="<%= folder.name%>">
                                    <button type="submit">Rename</button>
                                </div>
                            </form>
                        </li>
                        <% }); %>
                </ul>
                <%}%>
                <h2>your files</h2>
                    <% if(files.length !==0){ %>
                        <ul>
                            <% files.forEach((file)=>{ %>
                                <%-include('partials/fileItem',{file, folder: null})%>
                                <% }); %>
                        </ul>
                        <% } else{  %>
                            <p>No files are present</p>
                        <% } %>


                            <% } else { %>
                                <div>
                                    <a href="/auth/login">Login </a>
                                </div>
                                <div>
                                    <a href="/auth/sign-up">Register</a>
                                </div>
                                <% } %>

</body>


</html>
