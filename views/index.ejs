<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader</title>

    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/ui.js"></script>
</head>

<body>

    <main class="container">

        <%- include("partials/errors", { errors }) %>

            <% if(currentUser){ %>

                <header class="page-header">

                    <div>
                        <h1>📁 File Uploader</h1>
                        <p class="page-subtitle">
                            Logged in as <strong>
                                <%= currentUser.email %>
                            </strong>
                        </p>
                    </div>

                    <div class="header-actions">
                        <a class="btn btn-primary btn-small" href="/uploads/uploadFile">
                            Upload File
                        </a>

                        <a class="btn btn-secondary btn-small" href="/folders/new">
                            New Folder
                        </a>

                        <a class="btn btn-danger btn-small" href="/auth/logout">
                            Logout
                        </a>
                    </div>

                </header>

                <section>

                    <%- include('partials/incompleteUpload') %> 

                    <h2>Your Folders</h2>

                    <% if(folders.length===0){ %>

                        <div class="empty-state">
                            <h3>No folders yet</h3>
                            <p>Create your first folder.</p>
                        </div>

                        <% } else { %>

                            <ul class="folder-list">

                                <% folders.forEach(folder=> { %>

                                    <li class="folder-card">

                                        <div class="folder-header">

                                            <a class="folder-link" href="/folders/<%= folder.id %>">
                                                📁 <%= folder.name %>
                                            </a>

                                            <div class="folder-actions">

                                                <form action="/folders/<%= folder.id %>/delete"
                                                    class="delete-folder-form" method="post">

                                                    <button class="btn btn-danger btn-small" type="submit">

                                                        Delete

                                                    </button>

                                                </form>
                                                <button class="rename-btn btn btn-secondary btn-small"
                                                    data-id="<%=folder.id%>">Rename</button>

                                            </div>

                                        </div>

                                        <form action="/folders/<%= folder.id %>/rename" method="post"
                                            class="rename-form" id="rename-<%=folder.id%>" style="display:none;">

                                            <div class="form-group">

                                                <label for="newFolderName-<%= folder.id %>">
                                                    Folder Name
                                                </label>

                                                <input type="text" id="newFolderName-<%= folder.id %>"
                                                    name="newFolderName" value="<%= folder.name %>">

                                            </div>
                                            <div class="rename-actions">


                                                <button class="btn btn-primary btn-small" type="submit">

                                                    Save

                                                </button>
                                                <button class="btn btn-secondary btn-small cancel-rename" type="button"
                                                    data-id="<%= folder.id %>">
                                                    Cancel
                                                </button>
                                            </div>

                                        </form>

                                    </li>

                                    <% }) %>

                            </ul>

                            <% } %>

                </section>

                <section>

                    <h2>Your Files</h2>

                    <% if(files.length===0){ %>

                        <div class="empty-state">
                            <h3>No files uploaded</h3>
                            <p>Upload your first file.</p>
                        </div>

                        <% } else { %>

                            <ul class="file-list">

                                <% files.forEach(file=> { %>

                                    <%- include("partials/fileItem",{ file, folder:null }) %>

                                        <% }) %>

                            </ul>

                            <% } %>

                </section>

                <% } else { %>

                    <div class="auth-card">

                        <h1>📁 File Uploader</h1>

                        <p class="auth-subtitle">
                            Store and organize your files securely.
                        </p>

                        <a class="btn btn-primary" href="/auth/login">
                            Login
                        </a>

                        <br><br>

                        <a class="btn btn-secondary" href="/auth/sign-up">
                            Create Account
                        </a>

                    </div>

                    <% } %>

    </main>

</body>

</html>