<li>
    <a href="/files/<%=file.id%>/download">
        <%= file.originalName %>
    </a>

    <form action="/files/<%=file.id%>/delete" method="post" style="display: inline;"
        onsubmit="return confirm('Delete this file?')">
        <button type="submit">Delete</button>
    </form>
    
    <button id="renameBtn-<%=file.id%>" type="button" onclick="showRename('<%=file.id%>')">Rename</button>

    <form action="/files/<%=file.id%>/rename" id="rename-<%=file.id%>" method="post" style="display: none;">
        <div>
            <label for="newFileName-<%=file.id%>">fileName: </label>
            <input type="text" name="newFileName" id="newFileName-<%=file.id%>" value="<%=file.originalName%>">
            <button type="submit">Rename</button>
        </div>
    </form>

</li>