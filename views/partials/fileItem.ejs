
<li class="file-card">

    <div class="file-row">

        <div class="file-info">

            <a class="file-link" href="/files/<%= file.id %>">
                📄 <%= file.originalName %>
            </a>

        </div>

        <div class="file-actions">

            <form action="/files/<%= file.id %>/delete" method="post" class="delete-file-form">

                <input type="hidden" name="redirectTo" value="<%= folder ? '/folders/' + folder.id : '/' %>">

                <button class="btn btn-danger btn-small" type="submit">
                    Delete
                </button>

            </form>

            <button data-id="<%=file.id%>" class="rename-btn btn btn-secondary btn-small" type="button">

                Rename

            </button>

        </div>

    </div>

    <form action="/files/<%= file.id %>/rename" id="rename-<%= file.id %>" method="post" class="rename-form"
        style="display:none;">

        <div class="form-group">

            <label for="newFileName-<%= file.id %>">
                New Name
            </label>

            <input type="text" name="newFileName" id="newFileName-<%= file.id %>" value="<%= file.originalName %>">

            <input type="hidden" name="redirectTo" value="<%= folder ? '/folders/' + folder.id : '/' %>">

        </div>
        <div class="rename-actions">

            <button class="btn btn-primary btn-small" type="submit">
                Save
            </button>
            <button class="btn btn-secondary btn-small cancel-rename" type="button" data-id="<%= file.id %>">
                Cancel
            </button>
        </div>

    </form>

</li>