<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload File</title>
    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/upload.js"></script>
</head>

<body>
    <main class="auth-page">
        <div class="auth-card">
            <h1>Upload File</h1>
            <p class="auth-subtitle">

                <% if (folder) { %>
                    Uploading to <strong>📁 <%= folder.name %></strong>
                    <% } else { %>
                        Upload a file to your storage.
                        <% } %>
            </p>
            <%- include("partials/errors", { errors }) %>

                <form action="/uploads/uploadFile" method="post" enctype="multipart/form-data" id="upload-form">
                    <div class="form-group">
                        <input type="hidden" name="folderId" value="<%=folder ? folder.id : '' %>">
                    </div>

                    <div class="form-group">
                        <label for="up_file">Upload File: </label>
                        <input type="file" name="up_file" id="up_file" required>
                    </div>

                    <div class="form-group">
                        <progress id="upload-progress" value="0" max="100"></progress>
                        <span id="upload-percent">0%</span>
                    </div>
                    
                    <button class="btn btn-primary" type="submit">Upload</button>
                </form>
                <p class="auth-link">
                    <a href="<%=folder ? '/folders/' + folder.id : '/'%>">← Cancel</a>
                </p>
        </div>
    </main>
</body>

</html>